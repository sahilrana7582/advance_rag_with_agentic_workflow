# Sentinel AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# --- Go API ---
SRE_API_PORT=8080
SRE_API_HOST=0.0.0.0
SRE_API_ENV=development

# --- Database (Postgres) ---
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=sentinel
DB_PASSWORD=sentinel
DB_NAME=sentinel

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Kubernetes ---
KUBECONFIG=/Users/apple/.kube/config
KIND_CLUSTER_NAME=sentinel

# --- Prometheus ---
PROMETHEUS_URL=http://localhost:9090

# --- Loki ---
LOKI_URL=http://localhost:3100

# --- LLM (Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Agent Orchestrator ---
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_ENV=development
HUMAN_APPROVAL_REQUIRED=true